    { "name": "watchlistNodes", "maximum": 100, "atMaximum": "accepted", "overMaximum": "watchlist_limit_reached" },
    { "name": "trendPointsPerNode", "maximum": 500, "atMaximum": "accepted", "overMaximum": "oldest_point_evicted" },
    { "name": "mutationIdsPerSession", "maximum": 1000, "atMaximum": "accepted", "overMaximum": "operation_id_limit_reached" }
